# ── Domínio das instalações: cada cliente fica em {identificador}.{BASE_DOMAIN} ──
BASE_DOMAIN=localhost
# O mesmo domínio com os pontos escapados (uso em expressão regular): restly\.com\.br
BASE_DOMAIN_REGEX=localhost
PUBLIC_SCHEME=http
# Porta pública, se diferente de 80/443 (ex.: 8080 em desenvolvimento).
PUBLIC_PORT=8080
HTTP_PORT=8080
TLS_ENABLED=false
ACME_EMAIL=

# ── Segredos (gere com: openssl rand -base64 48) ──
# O mesmo AGENT_TOKEN deve ser configurado no Hub.
AGENT_TOKEN=
MYSQL_ROOT_PASSWORD=

# ── Imagens do Restly usadas nas instalações ──
RESTLY_BACKEND_IMAGE=restly-backend:local
RESTLY_WEB_IMAGE=restly-web:local

# Em desenvolvimento local (sem HTTPS) use "development"; em produção mantenha "production".
INSTANCE_NODE_ENV=development
INSTANCE_MEM_LIMIT=384m
MYSQL_BUFFER_POOL=512M
LICENSE_CHECK_INTERVAL_SECONDS=300
AGENT_PORT=4000
TZ=America/Sao_Paulo
