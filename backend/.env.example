DATABASE_URL=mysql://restly_hub:restly_hub@localhost:3308/restly_hub?allowPublicKeyRetrieval=true&connectionLimit=5
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Chave que criptografa os segredos da verificação em duas etapas (openssl rand -base64 48).
# Não troque depois de ativar a 2FA: os códigos deixariam de valer.
TOTP_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGIN=http://localhost:5174
PORT=3100
TZ=America/Sao_Paulo
HUB_PUBLIC_URL=http://host.docker.internal:3100

# Criação automática de instalações (agente em infra/). Vazio = apenas cadastro manual.
# AGENT_TOKEN deve ser igual ao configurado em infra/.env.
AGENT_URL=
AGENT_TOKEN=
