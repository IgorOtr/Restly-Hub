# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=restly_hub
MYSQL_USER=restly_hub
MYSQL_PASSWORD=restly_hub
MYSQL_PORT=3308

# Backend
BACKEND_PORT=3100
# Em produção: valores aleatórios e diferentes, com 32+ caracteres (openssl rand -base64 48).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGIN=http://localhost:5174
# Produção exige HTTPS.
COOKIE_SECURE=false
TZ=America/Sao_Paulo

# Endereço público do Hub, usado pelas instalações (LICENSE_HUB_URL).
HUB_PUBLIC_URL=https://hub.restly.com.br

# Chave privada Ed25519 (PEM) usada para assinar as licenças. Se vazia, o Hub gera
# uma no primeiro início e a guarda no banco.
HUB_SIGNING_PRIVATE_KEY=

# Swagger (/api/docs) — apenas em desenvolvimento; sem estas variáveis fica desativado.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Frontend
FRONTEND_PORT=5174

# Criação automática de instalações (agente em infra/). Vazio = apenas cadastro manual.
# AGENT_TOKEN deve ser igual ao configurado em infra/.env.
AGENT_URL=
AGENT_TOKEN=
